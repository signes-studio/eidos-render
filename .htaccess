# ==============================================================================
# EIDOS RENDER (.htaccess) — Optimización de Servidor, Seguridad y SEO Técnico
# ==============================================================================

# 1. MOTOR DE REESCRITURA Y FORZADO HTTPS CANÓNICO 301
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # A. Redirección canónica permanente 301: www -> sin-www (https://eidosrender.es)
    RewriteCond %{HTTP_HOST} ^www\.eidosrender\.es$ [NC]
    RewriteRule ^(.*)$ https://eidosrender.es/$1 [R=301,L]

    # B. Forzado permanente 301: HTTP -> HTTPS (Directo a https://eidosrender.es)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
    RewriteCond %{HTTP:X-Forwarded-SSL} =off [OR]
    RewriteCond %{HTTP:CF-Visitor} '"scheme":"http"'
    RewriteRule ^(.*)$ https://eidosrender.es/$1 [R=301,L]

    # C. Redirección 301 de URLs de servicios antiguas a las nuevas canónicas
    RewriteRule ^servicios/infografia-3d(\.html)?$ /infografia-3d-obra-nueva [R=301,L]
    RewriteRule ^servicios/video-3d(\.html)?$ /video-3d-promociones [R=301,L]
    RewriteRule ^servicios/web-real-estate(\.html)?$ /landing-page-promocion-inmobiliaria [R=301,L]
    RewriteRule ^servicios/material-comercial(\.html)?$ /dossier-y-flyer-venta-inmobiliario [R=301,L]
    RewriteRule ^servicios/captacion(\.html)?$ /captacion-digital-promociones [R=301,L]
    RewriteRule ^servicios/branding(\.html)?$ /servicios [R=301,L]
    RewriteRule ^obra-nueva(\.html)?$ /renders-promociones-inmobiliarias [R=301,L]
    RewriteRule ^vivienda-unifamiliar(\.html)?$ /infografia-3d-obra-nueva [R=301,L]
    RewriteRule ^reforma-de-piso(\.html)?$ /infografia-3d-obra-nueva [R=301,L]
    RewriteRule ^renders-para-house-flipping(\.html)?$ /infografia-3d-obra-nueva [R=301,L]
    RewriteRule ^renders-bilbao(\.html)?$ /servicios [R=301,L]
    RewriteRule ^renders-sevilla(\.html)?$ /servicios [R=301,L]

    # D. Redirecciones 301 de portfolio y casos legacy a proyectos individuales
    RewriteRule ^portfolio(\.html)?$ /proyectos [R=301,L]
    RewriteRule ^proyectos/madbit(\.html)?$ /proyectos/complejo-residencial-madbit [R=301,L]
    RewriteRule ^proyectos/altea-hills(\.html)?$ /proyectos/villa-unifamiliar-altea [R=301,L]
    RewriteRule ^proyectos/gare-des-mines(\.html)?$ /proyectos/regeneracion-urbana-gare-des-mines [R=301,L]
    RewriteRule ^proyectos/rozafa(\.html)?$ /proyectos [R=301,L]

    # E. Redirección externa 301 si se solicita un archivo con extensión .html
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP
    RewriteRule ^([^.]+)\.html$ https://eidosrender.es/$1 [R=301,L]

    # F. Eliminar barra final innecesaria en rutas que no sean la raíz ni el blog
    RewriteCond %{REQUEST_URI} !^/blog/
    RewriteCond %{REQUEST_URI} ^/(.+)/$
    RewriteRule ^ https://eidosrender.es/%1 [R=301,L]

    # G. Reescribir URLs limpias sin .html (ej. /video-3d-promociones -> /video-3d-promociones.html)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f [OR]
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^([^\.]+)$ $1.html [NC,L]
</IfModule>

# 2. CABECERAS DE SEGURIDAD HTTP
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"

    <Files "real-estate-launch.html">
        Header always set X-Robots-Tag "noindex, nofollow"
    </Files>
</IfModule>

# 3. COMPRESIÓN GZIP / DEFLATE
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Tipos MIME y Codificación UTF-8 para archivos de texto y LLMs
AddType "text/plain; charset=utf-8" .txt
AddCharset UTF-8 .txt

# 4. POLÍTICA DE CACHÉ DE NAVEGADOR (LEVERAGE BROWSER CACHING)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML y datos dinámicos
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType text/xml "access plus 0 seconds"

    # Fuentes Web
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"

    # Imágenes y Multimedia
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # CSS y JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
