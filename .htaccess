# ==============================================================================
# EIDOS RENDER (.htaccess) — Optimización de Servidor, Seguridad y SEO Técnico
# ==============================================================================

# 1. MOTOR DE REESCRITURA Y FORZADO HTTPS
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirección Permanente 301: HTTP -> HTTPS
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Redirección Permanente 301: www -> no-www (Canónico: https://eidosrender.es/)
    RewriteCond %{HTTP_HOST} ^www\.eidosrender\.es$ [NC]
    RewriteRule ^(.*)$ https://eidosrender.es/$1 [L,R=301]

    # Eliminar barra final innecesaria en archivos estándar si existe
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]
</IfModule>

# 2. CABECERAS DE SEGURIDAD HTTP
<IfModule mod_headers.c>
    # Forzar HTTPS durante 1 año (HSTS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
    # Prevenir MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Prevenir Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    # Política de Referrer para privacidad y analítica
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Prevenir ataques XSS reflejados
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# 3. COMPRESIÓN GZIP / DEFLATE
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 4. POLÍTICA DE CACHÉ DE NAVEGADOR (LEVERAGE BROWSER CACHING)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML y datos dinámicos
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType text/xml "access plus 0 seconds"

    # Fuentes Web
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"

    # Imágenes y Multimedia
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # CSS y JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# 5. PÁGINAS DE ERROR PERSONALIZADAS
ErrorDocument 404 /404.html
